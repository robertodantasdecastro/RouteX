{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RouteX",
  "version": "0.2.0-alpha",
  "identifier": "com.robertodantasdecastro.routex",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../frontend && corepack pnpm dev",
    "beforeBuildCommand": "cd ../frontend && corepack pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RouteX",
        "width": 1420,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Smart. Local. Private. Your way.",
    "longDescription": "RouteX is a local AI router for developers, exposing an OpenAI-compatible endpoint with manifest-driven routing, local-first policies, and an operator-friendly desktop shell for Cursor IDE and small teams.",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../dist/runtime/routex-alpha-runtime.tar.gz": "runtime/routex-alpha-runtime.tar.gz"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "windowSize": {
          "width": 680,
          "height": 420
        },
        "windowPosition": {
          "x": 200,
          "y": 180
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 500,
          "y": 170
        }
      }
    }
  }
}
